{
  "name": "memorant",
  "version": "0.1.0",
  "description": "书童 · Memorant: search and record bugs, snippets, daily logs, and ADRs in a local Markdown knowledge base.",
  "author": {
    "name": "tal"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/vault-stop.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/on-git-commit.sh"
          }
        ]
      }
    ]
  }
}
